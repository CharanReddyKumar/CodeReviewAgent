# Neo4j Configuration
# -------------------
# Connect to your local Neo4j instance.
# Ensure your Neo4j database is running (e.g., via Docker or Desktop).
# Default URI for local Neo4j is usually bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Azure OpenAI Configuration
# --------------------------
# You mentioned using Azure for the model.
# Fill in your Azure OpenAI details below.
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Agent Configuration
# -------------------
# Model selection (maps to Azure deployment if using Azure)
LLM_MODEL=gpt-4o
